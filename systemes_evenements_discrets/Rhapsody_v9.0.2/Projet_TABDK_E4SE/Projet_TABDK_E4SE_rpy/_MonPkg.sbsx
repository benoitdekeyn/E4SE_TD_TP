			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">if (niveau_batterie &lt; SEUIL_batterie) {%0D
	niveau_batterie = SEUIL_batterie+15;%0D
}%0D
if (niveau_batterie &gt; 100) {%0D
	niveau_batterie = 100;%0D
}</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID 983b6e68-a4f5-4d33-aa91-e883b2717b04</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">calcul_batterie</_name>
			<_modifiedTimeWeak type="a">11.4.2026::7:41:26</_modifiedTimeWeak>
			<_modifiedTime type="a">10.11.2026::14:42:0</_modifiedTime>
			<_lastID type="a">1</_lastID>
			<_virtual type="a">0</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">// --- PARAMETRES ET CONSTANTES ---%0D
const int deltaTms                    = 1000 / PARAM_SIMU_freq_rafraichissement; // Division enti%E8re en ms%0D
const double dt                       = (double)deltaTms / 1000.0;               // En secondes pour la physique%0D
%0D
// Seuils d'injection%0D
const double SEUIL_THROTTLE_MIN       = 1.5;%0D
const double SEUIL_THROTTLE_MAX       = 5.0;%0D
%0D
// Taux de charge et d%E9charge physiques (%25 par seconde)%0D
const double TAUX_CHARGE_PAR_THROTTLE = 0.5;%0D
const double TAUX_CHARGE_MAX_SEC      = TAUX_CHARGE_PAR_THROTTLE * SEUIL_THROTTLE_MAX;%0D
const double TAUX_DECHARGE_SEC        = 0.25;%0D
%0D
// --- LOGIQUE ---%0D
double new_niveau_batterie = niveau_batterie;%0D
%0D
if (throttle &gt; SEUIL_THROTTLE_MIN) {%0D
    const double taux_charge = (throttle &lt; SEUIL_THROTTLE_MAX)%0D
                               ? (TAUX_CHARGE_PAR_THROTTLE * throttle)%0D
                               : TAUX_CHARGE_MAX_SEC;%0D
%0D
    new_niveau_batterie += taux_charge * dt;%0D
    if (new_niveau_batterie &gt; 100.0) {%0D
        new_niveau_batterie = 100.0;%0D
    }%0D
} else {%0D
    new_niveau_batterie -= TAUX_DECHARGE_SEC * dt;%0D
    if (new_niveau_batterie &lt; 0.0) {%0D
        new_niveau_batterie = 0.0;%0D
    }%0D
}%0D
%0D
niveau_batterie = new_niveau_batterie;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID dfb4427c-1b11-4d74-b3a6-219e1b4ea976</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">calcul_regulateur_vitesse</_name>
			<_modifiedTimeWeak type="a">11.4.2026::7:41:26</_modifiedTimeWeak>
			<_modifiedTime type="a">10.13.2026::12:28:3</_modifiedTime>
			<_virtual type="a">0</_virtual>
			<Args type="c">
