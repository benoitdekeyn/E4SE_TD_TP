			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">int new_niveau_batterie = niveau_batterie_telephone; %0D
if (new_niveau_batterie &lt; 100){%0D
	new_niveau_batterie += 5;%0D
	}%0D
else{%0D
	new_niveau_batterie= 100;%0D
	}%0D
niveau_batterie_telephone=new_niveau_batterie;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
