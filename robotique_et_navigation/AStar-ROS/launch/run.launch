<?xml version="1.0"?>

<launch>
  <arg name="project" default="path_generator" />
  <!-- _sim_tb3 map_unit5_74x74x20cm -->
  <!--arg name="map_file" default="$(find path_generator)/map/map_unit5_74x74x20cm.yaml"/-->
  <!--arg name="map_file" default="/home/ubuntu/map_home_karto.yaml"/-->
<!--arg name="map_file" default="$(find path_generator)/map/map_4105_3m_005.yaml"/-->
<!--arg name="map_file" default="$(find path_generator)/map/map_4105_gmapping_002.yaml"/-->
<!--arg name="map_file" default="$(find path_generator)/map/map_4105_3m_005.yaml"/-->
<!--arg name="map_file" default="$(find path_generator)/map/map_4105_10m_10m_002.yaml"/-->
<!--arg name="map_file" default="$(find path_generator)/map/map_tb3_house.yaml"/-->
<arg name="map_file" default="$(find path_generator)/map/map_simu_tabdk.yaml"/>
 <arg name="open_rviz" default="true"/>
<rosparam command="load" file="$(find path_generator)/config/params.yaml" /> 

<!-- Turtlebot3 -->
<include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
    <arg name="model" value="burger" />
</include>

<!-- Map server -->
<node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" />

<!-- AMCL -->
<!-- AMCL -->
<include file="$(find turtlebot3_navigation)/launch/amcl.launch">
  <arg name="initial_pose_x" value="-3.0"/>
  <arg name="initial_pose_y" value="1.0"/>
  <arg name="initial_pose_a" value="0.0"/>
</include>

<!-- rviz -->
  <group if="$(arg open_rviz)"> 
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find path_generator)/rviz/turtlebot3_navigation_tabdk.rviz"/>
<!--      args="-d $(find turtlebot3_navigation)/rviz/turtlebot3_navigation.rviz"/> -->
  </group>

<node pkg="$(arg project)" type="$(arg project)" name="$(arg project)" output="screen" respawn="true" />
  
<!--node pkg="tb3_projet_gldd" type="planner3.py" name="planner3" output="screen" respawn="true" /-->

<!--node pkg="rviz" type="rviz" name="rviz_$(arg project)" args="-d $(find path_generator)/launch/Map.rviz" /-->


  
</launch>
