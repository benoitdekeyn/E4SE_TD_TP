		<IPrimitiveOperation type="e">
			<_id type="a">GUID 84108726-cfe5-4f75-b2cc-ef409ca1ace3</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">init</_name>
			<_modifiedTimeWeak type="a">10.10.2026::22:30:2</_modifiedTimeWeak>
			<_modifiedTime type="a">10.10.2026::22:30:2</_modifiedTime>
			<_virtual type="a">0</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">throttle=0.0;   %0D
speed=0;%0D
brakePedal=0;   %0D
accelPedal=0;%0D
float_speed=(double)speed;%0D
float_distance=(double)distance;%0D
%0D
const double MASSE         = (double)PARAM_SIMU_masse;%0D
const double PUISSANCE     = (double)PARAM_SIMU_puissance_moteur;%0D
const double AIR_DRAG      = PARAM_SIMU_frottement_air;%0D
const double VITESSE_REPOS = (double)PARAM_SIMU_vitesse_repos;%0D
%0D
// Calcul dynamique du ralenti d'%E9quilibre sur le plat (alpha = 0)%0D
const double vit_repos_ms = VITESSE_REPOS / 3.6;%0D
const double forceAir_repos = AIR_DRAG * vit_repos_ms * vit_repos_ms;%0D
const double forceRoulement_repos = 0.015 * MASSE * 9.81;%0D
%0D
throttle_repos = (forceAir_repos + forceRoulement_repos) / PUISSANCE;%0D
throttle = throttle_repos;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID 5e76483f-0284-4e22-a063-96103a89a0fb</_id>
