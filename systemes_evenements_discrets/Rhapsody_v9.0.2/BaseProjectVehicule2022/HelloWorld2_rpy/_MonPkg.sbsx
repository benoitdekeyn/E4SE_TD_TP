		<IPrimitiveOperation type="e">
			<_id type="a">GUID b750e185-5fe5-4be4-bfc9-d01fcced9d75</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">calcul_vitesse_distance</_name>
			<_modifiedTimeWeak type="a">10.10.2026::22:32:43</_modifiedTimeWeak>
			<_modifiedTime type="a">10.10.2026::22:32:43</_modifiedTime>
			<_lastID type="a">6</_lastID>
			<_virtual type="a">0</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">// --- PARAMETRES EXTERNES ---%0D
const double MAX_SPEED            = (double)PARAM_SIMU_max_speed;        // ex: 120 km/h%0D
const double MASSE                = (double)PARAM_SIMU_masse;            // ex: 1200 kg%0D
const double PUISSANCE            = (double)PARAM_SIMU_puissance_moteur; // ex: 600 N par unit%E9 de throttle%0D
const double FORCE_FREINS         = (double)PARAM_SIMU_puissance_frein;  // ex: 80 N%0D
const double DELTA_T_MS           = (double)PARAM_SIMU_deltaTms;         // ex: 50 ms%0D
const double CST_RALENTI          = throttle_repos;                      // ex: 1.0%0D
const double MAX_BRAKE            = (double)PARAM_SIMU_max_brake;        // ex: 10.0%0D
const double AIR_DRAG             = PARAM_SIMU_frottement_air;           // en kg/m (mettre ~0.4)%0D
%0D
// --- CONSTANTES PHYSIQUES ET MATHEMATIQUES ---%0D
const double CST_COEFF_ROULEMENT   = 0.015;%0D
const double CST_MULTIPLICATEUR_F  = 10.0;%0D
const double CST_GRAVITE           = 9.81;%0D
const double CST_PI_SUR_180        = 3.14159 / 180.0;%0D
const double CST_CONVERSION_KMH_MS = 3.6;%0D
const double CST_CONVERSION_MS_S   = 1000.0;%0D
const double ZERO                  = 0.0;%0D
%0D
// --- LOGIQUE ---%0D
const double dt = DELTA_T_MS / CST_CONVERSION_MS_S; // 0.05 s%0D
%0D
if (ignition == false) {%0D
    throttle = ZERO;%0D
}%0D
%0D
// 1. Force motrice / Frein moteur%0D
double forceMoteur = ZERO;%0D
%0D
if (throttle &lt;= CST_RALENTI || ignition == false) {%0D
    if (float_speed &gt; 10.0) {%0D
        // Au-dessus de 10 km/h pied lev%E9 : couple r%E9sistant m%E9canique (frein moteur ~300 N)%0D
        forceMoteur = -300.0;%0D
    } else {%0D
        // En dessous de 10 km/h : traction douce du ralenti pour ne pas caler%0D
        forceMoteur = throttle * PUISSANCE;%0D
    }%0D
} else {%0D
    // Phase d'acc%E9l%E9ration active (p%E9dale ou r%E9gulateur)%0D
    forceMoteur = throttle * PUISSANCE;%0D
}%0D
%0D
// 2. Calcul des forces r%E9sistantes (Unit%E9s SI : Newtons)%0D
const double vitesse_ms = float_speed / CST_CONVERSION_KMH_MS;%0D
%0D
// Tra%EEn%E9e a%E9rodynamique pure : F = (1/2 * rho * S * Cx) * v^2%0D
const double forceAir = AIR_DRAG * vitesse_ms * vitesse_ms;%0D
%0D
// Frottement au sol (roulement des pneumatiques)%0D
const double forceRoulement = CST_COEFF_ROULEMENT * MASSE * CST_GRAVITE * cos(alpha * CST_PI_SUR_180);%0D
%0D
// Gravit%E9 le long de la pente%0D
const double forceGravite = MASSE * CST_GRAVITE * sin(alpha * CST_PI_SUR_180);%0D
%0D
// Frein m%E9canique progressif%0D
double pedale_frein = brakePedal;%0D
if (pedale_frein &gt; MAX_BRAKE) pedale_frein = MAX_BRAKE;%0D
if (pedale_frein &lt; ZERO) pedale_frein = ZERO;%0D
const double forceFrein = (pedale_frein / MAX_BRAKE) * (FORCE_FREINS * CST_MULTIPLICATEUR_F * MASSE / 100.0);%0D
%0D
// 3. Somme des forces et acc%E9l%E9ration Newtonienne (m/s%B2)%0D
const double forceTotale = forceMoteur - forceFrein - forceAir - forceRoulement - forceGravite;%0D
const double acceleration = forceTotale / MASSE;%0D
%0D
// 4. Int%E9gration temporelle et bridage%0D
float_speed += (acceleration * dt) * CST_CONVERSION_KMH_MS;%0D
%0D
if (float_speed &gt; MAX_SPEED) float_speed = MAX_SPEED;%0D
if (float_speed &lt; ZERO) float_speed = ZERO;%0D
%0D
float_distance += (float_speed / CST_CONVERSION_KMH_MS) * dt;%0D
%0D
speed = (int)float_speed;%0D
distance = (int)float_distance;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID bd8fbf86-8498-47fb-aa99-e2a54231f8b8</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">freiner</_name>
			<_modifiedTimeWeak type="a">10.10.2026::22:28:19</_modifiedTimeWeak>
			<_modifiedTime type="a">10.10.2026::22:28:19</_modifiedTime>
