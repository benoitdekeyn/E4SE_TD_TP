			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">const double erreur = (double)(vitesseConsigne)+0.5 - float_speed;%0D
%0D
const double K_cube = PARAM_SIMU_Kp_regulateur;%0D
throttle += K_cube * erreur * erreur * erreur;%0D
%0D
if (throttle &gt; PARAM_SIMU_max_throttle) throttle = PARAM_SIMU_max_throttle;%0D
if (throttle &lt; throttle_repos)          throttle = throttle_repos;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
