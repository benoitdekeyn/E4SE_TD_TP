			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">#include &lt;windows.h&gt;%0D
#pragma comment(lib, &quot;winmm.lib&quot;)%0D
%0D
if (actif == 0) {%0D
	PlaySound(NULL, NULL, 0);%0D
	limiteur_depasse = false;%0D
} else {%0D
	PlaySound(TEXT(&quot;..\\..\\media\\alarme_incendie.wav&quot;), NULL, SND_FILENAME | SND_ASYNC);%0D
	limiteur_depasse = true;%0D
}</_bodyData>
			</IBody>
			</_itsBody>
			<AggregatesList type="e">
				<value>GUID f492748b-c74c-4512-8c11-4f1e252f9a3a</value>
