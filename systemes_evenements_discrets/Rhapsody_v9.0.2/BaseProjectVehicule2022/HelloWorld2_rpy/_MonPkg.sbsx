			<_name type="a">brakePedal</_name>
			<_modifiedTimeWeak type="a">3.22.2020::23:34:1</_modifiedTimeWeak>
			<_modifiedTime type="a">3.22.2020::23:34:1</_modifiedTime>
			<_typeOf type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
