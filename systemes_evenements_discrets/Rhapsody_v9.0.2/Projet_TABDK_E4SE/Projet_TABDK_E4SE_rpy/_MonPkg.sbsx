			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">int new_niveau_batterie = niveau_batterie_telephone; %0D
if (new_niveau_batterie &gt; 0){%0D
	new_niveau_batterie -= 1;%0D
	}%0D
else{%0D
	new_niveau_batterie=0;%0D
	}%0D
niveau_batterie_telephone=new_niveau_batterie;</_bodyData>
