			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">double new_niveau_batterie = niveau_batterie;%0D
%0D
if (throttle &gt; 1) {%0D
%0D
	if (throttle &lt; 5) {%0D
		new_niveau_batterie += 0.0125*throttle;%0D
	} else {%0D
		new_niveau_batterie += 0.0125*5;%0D
	}%0D
	if (new_niveau_batterie &gt; 100.0) {%0D
		new_niveau_batterie = 100;%0D
	}%0D
	%0D
} else {%0D
%0D
	new_niveau_batterie -= 0.05;%0D
	if (new_niveau_batterie &lt; 0.0) {%0D
		new_niveau_batterie = 0;%0D
	}%0D
}%0D
%0D
niveau_batterie = new_niveau_batterie;</_bodyData>
			</IBody>
			</_itsBody>
			<AggregatesList type="e">
