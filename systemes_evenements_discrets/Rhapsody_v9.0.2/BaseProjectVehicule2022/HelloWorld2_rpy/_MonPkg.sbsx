		<IPrimitiveOperation type="e">
			<_id type="a">GUID bec57d30-92a1-4e54-9440-3015433a0e2f</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">accelerer</_name>
			<_modifiedTimeWeak type="a">10.10.2026::22:31:42</_modifiedTimeWeak>
			<_modifiedTime type="a">10.10.2026::22:31:42</_modifiedTime>
			<_lastID type="a">2</_lastID>
			<_virtual type="a">0</_virtual>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">// --- PARAMETRES EXTERNES ---%0D
const double MAX_THROTTLE = PARAM_SIMU_max_throttle;%0D
const double CST_RALENTI  = throttle_repos;%0D
const double MAX_ACCEL    = (double)PARAM_SIMU_max_accel;%0D
%0D
// --- LOGIQUE ---%0D
if (ignition == true) {%0D
    // Si la p%E9dale d%E9passe la borne physique, on la bride%0D
    double pedale = accelPedal;%0D
    if (pedale &gt; MAX_ACCEL) pedale = MAX_ACCEL;%0D
    if (pedale &lt; 0.0) pedale = 0.0;%0D
%0D
    // Mise %E0 l'%E9chelle : 0-&gt;10 sur la p%E9dale donne 1.0-&gt;10.0 sur le throttle%0D
    double plage_utile = MAX_THROTTLE - CST_RALENTI;%0D
    throttle = CST_RALENTI + (pedale / MAX_ACCEL) * plage_utile;%0D
}</_bodyData>
			</IBody>
