			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">const double erreur = (double)vitesseConsigne+0.5 - (double)float_speed;%0D
%0D
steady += Ki_regulateur * erreur;%0D
%0D
if (steady &gt; PARAM_SIMU_max_throttle) steady = PARAM_SIMU_max_throttle;%0D
if (steady &lt; throttle_repos)          steady = throttle_repos;%0D
%0D
double commande = steady + (Kp_regulateur * erreur);%0D
%0D
if (commande &gt; PARAM_SIMU_max_throttle) commande = PARAM_SIMU_max_throttle;%0D
if (commande &lt; throttle_repos)          commande = throttle_repos;%0D
%0D
throttle = commande;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID 0b123356-9f3a-4c8e-a8ac-42df7bb4b305</_id>
			<_myState type="a">8192</_myState>
