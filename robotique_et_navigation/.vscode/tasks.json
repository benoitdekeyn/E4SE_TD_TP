{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Installation automatique (VcXsrv, extensions, clé SSH)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\setup.ps1\"",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "presentation": { "reveal": "always", "panel": "dedicated", "close": true },
      "problemMatcher": []
    },
    {
      "label": "Robot : synchronisation initiale",
      "dependsOn": "Installation automatique (VcXsrv, extensions, clé SSH)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder:GitHub Local}\\.vscode\\sync_robot.ps1"],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false, "close": true },
      "problemMatcher": []
    },
    {
      "label": "Démarrer serveur X (VcXsrv)",
      "dependsOn": "Installation automatique (VcXsrv, extensions, clé SSH)",
      "type": "shell",
      "command": "if (-not (Get-Process vcxsrv -ErrorAction SilentlyContinue)) { Start-Process 'C:\\Program Files\\VcXsrv\\vcxsrv.exe' -ArgumentList ':0','-multiwindow','-clipboard','-wgl','-ac' }",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never", "close": true },
      "problemMatcher": []
    },
    {
      "label": "Robot : run_robot.sh",
      "dependsOn": "Installation automatique (VcXsrv, extensions, clé SSH)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\connect.ps1\" -Mode run",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false },
      "problemMatcher": []
    },
    {
      "label": "Robot : terminal libre",
      "dependsOn": "Installation automatique (VcXsrv, extensions, clé SSH)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\connect.ps1\" -Mode shell",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    }
  ]
}
