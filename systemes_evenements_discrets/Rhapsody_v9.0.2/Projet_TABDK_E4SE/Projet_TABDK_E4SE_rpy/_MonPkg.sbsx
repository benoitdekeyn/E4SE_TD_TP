			<_modifiedTime type="a">10.11.2026::14:49:2</_modifiedTime>
			<_lastID type="a">2</_lastID>
			<_virtual type="a">0</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">const double COEF_CONSO = 0.005;%0D
%0D
double new_reservoir_carburant = reservoir_carburant;%0D
%0D
new_reservoir_carburant -= throttle*COEF_CONSO;%0D
%0D
if (new_reservoir_carburant &lt; 0.0) {%0D
	new_reservoir_carburant = 0;%0D
} %0D
%0D
reservoir_carburant = new_reservoir_carburant;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
