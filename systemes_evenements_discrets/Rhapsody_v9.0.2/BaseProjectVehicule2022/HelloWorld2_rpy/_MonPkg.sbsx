			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">double new_reservoir_carburant = reservoir_carburant;%0D
%0D
new_reservoir_carburant -= throttle*0.01;%0D
%0D
if (new_reservoir_carburant &lt; 0.0) {%0D
	new_reservoir_carburant = 0;%0D
} %0D
%0D
reservoir_carburant = new_reservoir_carburant;</_bodyData>
			</IBody>
			</_itsBody>
